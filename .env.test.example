# =============================================================================
# 통합 테스트 / E2E 전용 환경변수 예시
#   cp .env.test.example .env.test
# 통합 테스트는 테이블을 비우므로 반드시 개발/운영과 분리된 테스트 DB 를 사용하세요.
# (DATABASE_URL 에 "test" 가 포함되어 있지 않으면 실행이 즉시 중단됩니다)
# =============================================================================

DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/parking_management_test"

NEXTAUTH_SECRET="test-secret-for-integration-tests-only-0123456789"
RESERVATION_TOKEN_SECRET="test-token-secret-for-integration-tests-0123456789"
APP_BASE_URL="http://localhost:3100"
APP_TIME_ZONE="Asia/Seoul"
SESSION_MAX_AGE_MINUTES="480"

# 통합/E2E 테스트에서는 실제 메일을 발송하지 않습니다.
# (E2E 는 playwright.config.ts 에서 file 공급자로 덮어씁니다)
EMAIL_PROVIDER="mock"

GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REDIRECT_URI=""
GMAIL_REFRESH_TOKEN=""
GMAIL_SENDER_EMAIL="test-sender@example.com"
GMAIL_SENDER_NAME="본사 주차관리(테스트)"

CRON_SECRET="test-cron-secret"

SEED_ADMIN_LOGIN_ID="admin"
SEED_ADMIN_PASSWORD="Admin!2345"
SEED_ADMIN_NAME="시스템관리자"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NOTIFICATION_EMAILS="parking-admin@example.com"
