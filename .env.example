# =============================================================================
# 본사 주차 예약 관리 시스템 - 환경변수 예시
# -----------------------------------------------------------------------------
# 이 파일은 예시 템플릿입니다. 실제 비밀값을 절대 이 파일에 적지 마세요.
#   cp .env.example .env
# 로 복사한 뒤 .env 파일에만 실제 값을 채워 넣습니다. (.env 는 git 에 커밋되지 않습니다)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 데이터베이스 (MySQL 8.x)
# -----------------------------------------------------------------------------
# 형식: mysql://<사용자>:<비밀번호>@<호스트>:<포트>/<데이터베이스명>
# 비밀번호에 @ : / ? # 등 특수문자가 있으면 URL 인코딩해야 합니다. (예: @ -> %40)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/parking_management"

# -----------------------------------------------------------------------------
# 2. 애플리케이션 공통
# -----------------------------------------------------------------------------
# 관리자 세션 쿠키(JWT) 서명 키. 최소 32자 이상의 랜덤 문자열을 사용하세요.
#   생성 예: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NEXTAUTH_SECRET="change-me-to-a-long-random-secret"

# 예약 조회 토큰(HMAC-SHA256) 서명 키. NEXTAUTH_SECRET 과 반드시 다른 값을 사용하세요.
# 이 값이 바뀌면 이미 발송된 예약 조회 링크는 모두 무효가 됩니다.
RESERVATION_TOKEN_SECRET="change-me-to-a-long-random-secret"

# 이메일 본문의 예약 조회 링크, 관리자 상세 링크 생성에 사용하는 기준 URL
APP_BASE_URL="http://localhost:3000"

# 모든 날짜/시간 표시 기준 타임존
APP_TIME_ZONE="Asia/Seoul"

# 관리자 세션 유효시간(분). 미설정 시 480분(8시간)
SESSION_MAX_AGE_MINUTES="480"

# -----------------------------------------------------------------------------
# 3. Gmail API (SMTP 아님)
# -----------------------------------------------------------------------------
# Google Cloud Console 에서 발급한 OAuth 2.0 클라이언트 정보입니다.
# 필요한 OAuth Scope: https://www.googleapis.com/auth/gmail.send
# 값을 채우는 절차는 README.md 의 "13. Gmail API 설정 방법" 을 참고하세요.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REDIRECT_URI=""
GMAIL_REFRESH_TOKEN=""
GMAIL_SENDER_EMAIL=""
GMAIL_SENDER_NAME="SYNOPEX PARKING"

# 이메일 공급자 선택: gmail | file | log | mock
#   gmail : Gmail API 로 실제 발송 (운영/스테이징)
#   file  : 실제 발송하지 않고 JSON 파일로 저장 (로컬에서 예약 조회 링크 확인 / E2E)
#   log   : 실제 발송하지 않고 콘솔에 제목/수신자만 출력 (로컬 개발 기본값)
#   mock  : 실제 발송하지 않고 메모리에만 적재 (자동화 테스트)
EMAIL_PROVIDER="log"

# -----------------------------------------------------------------------------
# 4. 스케줄러(cron)
# -----------------------------------------------------------------------------
# POST /api/cron/exit-reminders 호출 시 Authorization: Bearer <CRON_SECRET> 로 검증합니다.
# 같은 값으로 /api/cron/auto-no-show, /api/cron/audit-log-cleanup 도 인증합니다.
CRON_SECRET="change-me-to-a-long-random-secret"

# -----------------------------------------------------------------------------
# 5. Seed 초기 데이터 (개발 환경 전용)
# -----------------------------------------------------------------------------
# `npm run db:seed` 실행 시 생성되는 최초 SYSTEM_ADMIN 계정 정보입니다.
# 운영 환경에서는 반드시 강력한 임시 비밀번호를 지정하고, 최초 로그인 직후 변경하세요.
SEED_ADMIN_PASSWORD="Admin!2345"
SEED_ADMIN_NAME="시스템관리자"
SEED_ADMIN_EMAIL="admin@example.com"

# 관리자 알림 수신 이메일 목록(쉼표 구분). 개발 환경에서는 예시 주소를 사용하세요.
SEED_ADMIN_NOTIFICATION_EMAILS="parking-admin@example.com"
