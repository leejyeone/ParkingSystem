// 본사 주차 예약 관리 시스템 - Prisma Schema
//
// 설계 제약(반드시 유지):
//  - vehicles 테이블을 만들지 않는다. 차량번호는 parking_reservations 에 직접 저장한다.
//  - users(회원) 계정은 "선택" 이다. 비로그인으로도 신청/조회가 모두 가능해야 한다.
//    회원 정보는 신청 폼 자동완성과 내 예약 목록에만 사용한다.
//  - 도면 좌표 컬럼(map_x, map_y, map_width, map_height)을 만들지 않는다.
//  - 주차면 배정은 주차면 코드(A-01 ...) 기반으로만 처리한다.
//  - 예약 접근 토큰 원문은 저장하지 않고 HMAC-SHA256 해시만 저장한다.
//  - 화면/이메일에 개인정보 마스킹은 적용하지 않는다(원문 표시). 따라서 마스킹 전용 컬럼도 두지 않는다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enum
// ---------------------------------------------------------------------------

/// 관리자 계정 상태
enum AccountStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

/// 주차면 유형
enum SpaceType {
  NORMAL
  DOUBLE
  DISABLED
  EV
  UNAVAILABLE
}

/// 신청 구분 (분류값일 뿐이며 권한 차이는 없다)
enum RequesterType {
  VISITOR
  EMPLOYEE
}

/// 예약 상태
enum ReservationStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
  PARKING
  EXITED
  NO_SHOW
}

/// 예약 접근 토큰 유형
/// 상태 변경 주체
enum ChangedByType {
  REQUESTER
  ADMIN
  SYSTEM
}

/// 이메일 종류
enum EmailType {
  REQUEST_RECEIVED
  NEW_REQUEST_TO_ADMIN
  APPROVED
  REJECTED
  UPDATED
  CANCELLED
  EXIT_REMINDER
  ENTRY_REMINDER
}

/// 이메일 발송 상태
enum EmailSendStatus {
  PENDING
  SUCCESS
  FAILED
}

// ---------------------------------------------------------------------------
// 8-1. admin_users
// ---------------------------------------------------------------------------

model AdminUser {
  adminUserId   Int           @id @default(autoincrement()) @map("admin_user_id")
  /// bcrypt 해시. 평문 비밀번호는 절대 저장하지 않는다.
  passwordHash  String        @map("password_hash") @db.VarChar(255)
  adminName     String        @map("admin_name") @db.VarChar(50)
  email         String        @unique(map: "uq_admin_users_email") @db.VarChar(255)
  phone         String?       @db.VarChar(20)
  accountStatus AccountStatus @default(ACTIVE) @map("account_status")

  /// brute-force 방지용. 연속 로그인 실패 횟수
  loginFailCount Int       @default(0) @map("login_fail_count")
  /// 계정 임시 잠금 해제 시각
  lockedUntil    DateTime? @map("locked_until")

  lastLoginAt       DateTime? @map("last_login_at")
  passwordChangedAt DateTime? @map("password_changed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  approvedReservations ParkingReservation[]          @relation("ReservationApprovalAdmin")
  statusLogs           ParkingReservationStatusLog[]
  auditLogs            AuditLog[]
  updatedSettings      SystemSetting[]

  @@index([accountStatus], map: "idx_admin_users_account_status")
  @@map("admin_users")
}

// ---------------------------------------------------------------------------
// users - 일반 사용자(회원) 계정
//
// 로그인은 "선택" 이다. 비로그인 상태로도 주차 신청과 예약 조회가 모두 가능하며,
// 회원 로그인은 신청 폼 자동완성과 내 예약 목록을 위해서만 사용한다.
// 자동완성에 필요한 항목과 인증에 필요한 항목만 저장한다.
// ---------------------------------------------------------------------------

model SiteUser {
  userId       Int    @id @default(autoincrement()) @map("user_id")
  email        String @unique(map: "uq_users_email") @db.VarChar(255)
  /// bcrypt 해시. 평문 비밀번호는 절대 저장하지 않는다.
  passwordHash String @map("password_hash") @db.VarChar(255)

  /// 신청 폼 자동완성용 기본 정보
  name                String  @db.VarChar(50)
  companyOrBranchName String  @map("company_or_branch_name") @db.VarChar(100)
  vehicleNo           String? @map("vehicle_no") @db.VarChar(20)

  accountStatus AccountStatus @default(ACTIVE) @map("account_status")

  /// brute-force 방지용. 연속 로그인 실패 횟수
  loginFailCount Int       @default(0) @map("login_fail_count")
  /// 계정 임시 잠금 해제 시각
  lockedUntil    DateTime? @map("locked_until")

  lastLoginAt       DateTime? @map("last_login_at")
  passwordChangedAt DateTime? @map("password_changed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  reservations ParkingReservation[]

  @@index([accountStatus], map: "idx_users_account_status")
  @@map("users")
}

// ---------------------------------------------------------------------------
// employees - 직원 계정
//
// 방문객(SiteUser)과 완전히 별도의 테이블·로그인 세션이다. 비밀번호가 없다 —
// 전 직원 명부 엑셀을 시드 스크립트(scripts/import-employees.ts)로 1회성 주입해 두고,
// 로그인은 사번(employeeCode)만 맞으면 그 즉시 세션이 발급된다. 그룹웨어가 실제로
// 넘겨주는 방식(`page.asp?Fsacode=사번` GET 파라미터)과 동일한 모양이다 — 운영에서는
// 그룹웨어가 이미 로그인된 사용자에게만 이 링크를 태워주므로 그 시점에 사번을 아는 것
// 자체가 신뢰 경계 역할을 한다. 그룹웨어 SSO 연동 시에도 이 테이블만 손보면 된다.
// ---------------------------------------------------------------------------

model EmployeeUser {
  employeeUserId Int     @id @default(autoincrement()) @map("employee_user_id")
  /// 그룹웨어 세션의 사번(Fsacode/CCode). 로그인·그룹웨어 매핑의 유일한 키 — 비밀번호는 없다.
  employeeCode   String  @unique(map: "uq_employee_users_employee_code") @map("employee_code") @db.VarChar(20)
  email          String  @unique(map: "uq_employee_users_email") @db.VarChar(255)
  name           String  @db.VarChar(50)
  /// 그룹웨어 조회 결과의 부서명(buseo).
  departmentName String  @map("department_name") @db.VarChar(100)
  /// 그룹웨어 조회 결과의 부서코드(DEPT_ID). 화면에는 노출하지 않고 향후 그룹웨어 재대조용으로만 보관.
  departmentCode String? @map("department_code") @db.VarChar(50)
  /// 신청 폼 자동완성용(선택). 명부 엑셀에는 없는 값이라 직원이 마이페이지에서 직접 입력해 채운다.
  vehicleNo      String? @map("vehicle_no") @db.VarChar(20)

  accountStatus AccountStatus @default(ACTIVE) @map("account_status")

  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  reservations ParkingReservation[]

  @@index([accountStatus], map: "idx_employee_users_account_status")
  @@map("employee_users")
}

// ---------------------------------------------------------------------------
// 8-2. parking_areas
// ---------------------------------------------------------------------------

model ParkingArea {
  areaId            Int       @id @default(autoincrement()) @map("area_id")
  areaCode          String    @unique(map: "uq_parking_areas_area_code") @map("area_code") @db.VarChar(20)
  areaName          String    @map("area_name") @db.VarChar(100)
  description       String?   @db.VarChar(500)
  /// 참고용 도면 이미지. 파일 자체를 DB 에 보관한다(별도 스토리지·업로드 디렉터리 불필요).
  /// 좌표 정보는 저장하지 않는다.
  mapImageData      Bytes?    @map("map_image_data")
  mapImageMimeType  String?   @map("map_image_mime_type") @db.VarChar(100)
  mapImageName      String?   @map("map_image_name") @db.VarChar(255)
  /// 도면이 바뀌면 갱신한다. 브라우저 캐시를 무효화하는 데 쓴다.
  mapImageUpdatedAt DateTime? @map("map_image_updated_at")
  displayOrder      Int       @default(0) @map("display_order")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  spaces ParkingSpace[]

  @@index([isActive, displayOrder], map: "idx_parking_areas_active_order")
  @@map("parking_areas")
}

// ---------------------------------------------------------------------------
// 8-3. parking_spaces
// ---------------------------------------------------------------------------

model ParkingSpace {
  spaceId      Int       @id @default(autoincrement()) @map("space_id")
  areaId       Int       @map("area_id")
  spaceCode    String    @map("space_code") @db.VarChar(20)
  spaceName    String?   @map("space_name") @db.VarChar(100)
  spaceType    SpaceType @default(NORMAL) @map("space_type")
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  memo         String?   @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  area                 ParkingArea          @relation(fields: [areaId], references: [areaId])
  assignedReservations ParkingReservation[] @relation("ReservationAssignedSpace")

  @@unique([areaId, spaceCode], map: "uq_parking_spaces_area_code")
  @@index([spaceType, isActive, displayOrder], map: "idx_parking_spaces_type_active_order")
  @@map("parking_spaces")
}

// ---------------------------------------------------------------------------
// 8-4. parking_reservations
// ---------------------------------------------------------------------------

model ParkingReservation {
  reservationId Int    @id @default(autoincrement()) @map("reservation_id")
  reservationNo String @unique(map: "uq_parking_reservations_no") @map("reservation_no") @db.VarChar(30)

  /// 방문객 회원이 로그인해서 본인 명의로 신청한 경우에만 연결된다. 비로그인/직원 신청은 NULL.
  visitorUserId Int? @map("visitor_user_id")

  /// 직원이 관여한 예약(본인 방문 또는 담당 방문객 대리 신청)이면 그 직원 계정. 그 외에는 NULL.
  /// requesterType 이 EMPLOYEE 면 본인 방문, VISITOR 면 대리 신청이라는 뜻이다.
  employeeUserId Int? @map("employee_user_id")

  requesterType       RequesterType @map("requester_type")
  companyOrBranchName String        @map("company_or_branch_name") @db.VarChar(100)
  requesterName       String        @map("requester_name") @db.VarChar(50)
  requesterEmail      String        @map("requester_email") @db.VarChar(255)

  /// 공백/하이픈을 제거해 정규화한 차량번호
  vehicleNo String @map("vehicle_no") @db.VarChar(20)

  visitPurpose String? @map("visit_purpose") @db.VarChar(200)
  requestMemo  String? @map("request_memo") @db.Text

  /// 모든 시각은 UTC로 저장하고 화면/메일에서 Asia/Seoul로 변환한다.
  visitStartAt  DateTime  @map("visit_start_at")
  visitEndAt    DateTime  @map("visit_end_at")
  actualEntryAt DateTime? @map("actual_entry_at")
  actualExitAt  DateTime? @map("actual_exit_at")

  assignedSpaceId Int? @map("assigned_space_id")

  reservationStatus ReservationStatus @default(REQUESTED) @map("reservation_status")

  approvalAdminId Int?      @map("approval_admin_id")
  approvedAt      DateTime? @map("approved_at")
  rejectedAt      DateTime? @map("rejected_at")
  rejectionReason String?   @map("rejection_reason") @db.VarChar(500)
  cancelledAt     DateTime? @map("cancelled_at")
  cancelReason    String?   @map("cancel_reason") @db.VarChar(500)

  privacyConsentAt DateTime @map("privacy_consent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignedSpace ParkingSpace? @relation("ReservationAssignedSpace", fields: [assignedSpaceId], references: [spaceId], onDelete: SetNull)
  approvalAdmin AdminUser?    @relation("ReservationApprovalAdmin", fields: [approvalAdminId], references: [adminUserId], onDelete: SetNull)
  visitorUser   SiteUser?     @relation(fields: [visitorUserId], references: [userId], onDelete: SetNull)
  employeeUser  EmployeeUser? @relation(fields: [employeeUserId], references: [employeeUserId], onDelete: SetNull)

  accessTokens ReservationAccessToken[]
  statusLogs   ParkingReservationStatusLog[]
  emailLogs    EmailSendLog[]

  @@index([visitorUserId, createdAt], map: "idx_reservations_visitor_user_created")
  @@index([employeeUserId, createdAt], map: "idx_reservations_employee_user_created")
  @@index([createdAt], map: "idx_reservations_created")
  @@index([reservationStatus], map: "idx_reservations_status")
  @@index([visitStartAt, visitEndAt], map: "idx_reservations_visit_range")
  @@index([assignedSpaceId, visitStartAt, visitEndAt, reservationStatus], map: "idx_reservations_space_range_status")
  @@index([vehicleNo, visitStartAt, visitEndAt], map: "idx_reservations_vehicle_range")
  @@index([requesterEmail, createdAt], map: "idx_reservations_email_created")
  @@index([approvalAdminId], map: "idx_reservations_approval_admin")
  @@map("parking_reservations")
}

// ---------------------------------------------------------------------------
// 8-5. reservation_access_tokens
// ---------------------------------------------------------------------------

model ReservationAccessToken {
  tokenId       Int      @id @default(autoincrement()) @map("token_id")
  reservationId Int      @map("reservation_id")
  /// HMAC-SHA256(RESERVATION_TOKEN_SECRET, 원본토큰) hex. 원본은 저장하지 않는다.
  tokenHash     String   @unique(map: "uq_reservation_access_tokens_hash") @map("token_hash") @db.VarChar(64)
  expiresAt     DateTime @map("expires_at")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  reservation ParkingReservation @relation(fields: [reservationId], references: [reservationId], onDelete: Cascade)

  @@index([reservationId, isActive], map: "idx_access_tokens_reservation")
  @@map("reservation_access_tokens")
}

// ---------------------------------------------------------------------------
// 8-6. parking_reservation_status_logs
// ---------------------------------------------------------------------------

model ParkingReservationStatusLog {
  statusLogId      Int                @id @default(autoincrement()) @map("status_log_id")
  reservationId    Int                @map("reservation_id")
  previousStatus   ReservationStatus? @map("previous_status")
  currentStatus    ReservationStatus  @map("current_status")
  changedByType    ChangedByType      @map("changed_by_type")
  changedByAdminId Int?               @map("changed_by_admin_id")
  changeReason     String?            @map("change_reason") @db.VarChar(500)
  createdAt        DateTime           @default(now()) @map("created_at")

  reservation    ParkingReservation @relation(fields: [reservationId], references: [reservationId], onDelete: Cascade)
  changedByAdmin AdminUser?         @relation(fields: [changedByAdminId], references: [adminUserId], onDelete: SetNull)

  @@index([reservationId, createdAt], map: "idx_status_logs_reservation_created")
  @@index([changedByAdminId], map: "idx_status_logs_admin")
  @@map("parking_reservation_status_logs")
}

// ---------------------------------------------------------------------------
// 8-7. admin_notification_emails
// ---------------------------------------------------------------------------

model AdminNotificationEmail {
  notificationEmailId Int     @id @default(autoincrement()) @map("notification_email_id")
  email               String  @unique(map: "uq_admin_notification_emails_email") @db.VarChar(255)
  recipientName       String? @map("recipient_name") @db.VarChar(50)

  receiveNewRequest    Boolean @default(true) @map("receive_new_request")
  receiveApprovalAlert Boolean @default(true) @map("receive_approval_alert")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive], map: "idx_admin_notification_emails_active")
  @@map("admin_notification_emails")
}

// ---------------------------------------------------------------------------
// 8-8. email_send_logs
// ---------------------------------------------------------------------------

model EmailSendLog {
  emailLogId        Int             @id @default(autoincrement()) @map("email_log_id")
  reservationId     Int?            @map("reservation_id")
  emailType         EmailType       @map("email_type")
  recipientEmail    String          @map("recipient_email") @db.VarChar(255)
  subject           String          @db.VarChar(300)
  /// 실제 발송한 HTML 본문. 실패 건 재발송 시 원문 그대로 다시 보내는 데 쓴다.
  bodyHtml          String?         @map("body_html") @db.LongText
  /// 실제 발송한 텍스트 본문.
  bodyText          String?         @map("body_text") @db.LongText
  sendStatus        EmailSendStatus @default(PENDING) @map("send_status")
  providerMessageId String?         @map("provider_message_id") @db.VarChar(255)
  failReason        String?         @map("fail_reason") @db.Text
  retryCount        Int             @default(0) @map("retry_count")
  requestedAt       DateTime        @default(now()) @map("requested_at")
  sentAt            DateTime?       @map("sent_at")

  /// 1회만 발송되어야 하는 메일(EXIT_REMINDER)의 멱등성 키.
  /// "<reservationId>:<emailType>" 형태이며 그 외 메일에서는 NULL 이다.
  /// MySQL 의 UNIQUE 인덱스는 NULL 을 중복 허용하므로 부분 유니크처럼 동작한다.
  dedupeKey String? @unique(map: "uq_email_send_logs_dedupe_key") @map("dedupe_key") @db.VarChar(100)

  /// 이 행이 어느 실패 건의 재발송인지. 원본(최초 발송)은 항상 NULL이다.
  /// 재발송을 다시 재발송해도 이 값은 항상 최초 원본을 가리킨다(체인이 아니라 트리 루트) —
  /// 한 실패 건의 재발송 이력을 한 번의 조회로 모을 수 있다.
  resendOfLogId Int?           @map("resend_of_log_id")
  resendOf      EmailSendLog?  @relation("EmailResend", fields: [resendOfLogId], references: [emailLogId], onDelete: SetNull)
  resends       EmailSendLog[] @relation("EmailResend")

  reservation ParkingReservation? @relation(fields: [reservationId], references: [reservationId], onDelete: SetNull)

  @@index([reservationId, emailType, sendStatus], map: "idx_email_logs_reservation_type_status")
  @@index([sendStatus, requestedAt], map: "idx_email_logs_status_requested")
  @@index([resendOfLogId], map: "idx_email_logs_resend_of")
  @@map("email_send_logs")
}

// ---------------------------------------------------------------------------
// 8-9. audit_logs
// ---------------------------------------------------------------------------

model AuditLog {
  auditLogId   Int      @id @default(autoincrement()) @map("audit_log_id")
  actorAdminId Int?     @map("actor_admin_id")
  actionType   String   @map("action_type") @db.VarChar(50)
  targetType   String   @map("target_type") @db.VarChar(50)
  targetId     String?  @map("target_id") @db.VarChar(50)
  detailJson   Json?    @map("detail_json")
  ipAddress    String?  @map("ip_address") @db.VarChar(64)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")

  actorAdmin AdminUser? @relation(fields: [actorAdminId], references: [adminUserId], onDelete: SetNull)

  @@index([actorAdminId, createdAt], map: "idx_audit_logs_actor_created")
  @@index([actionType, createdAt], map: "idx_audit_logs_action_created")
  @@index([targetType, targetId], map: "idx_audit_logs_target")
  // 보관 기간이 지난 기록을 정리(DELETE ... WHERE created_at < ?)할 때 사용한다.
  @@index([createdAt], map: "idx_audit_logs_created_at")
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// 8-10. system_settings
// ---------------------------------------------------------------------------

model SystemSetting {
  settingKey       String   @id @map("setting_key") @db.VarChar(100)
  settingValue     String   @map("setting_value") @db.VarChar(500)
  description      String?  @db.VarChar(500)
  updatedByAdminId Int?     @map("updated_by_admin_id")
  updatedAt        DateTime @updatedAt @map("updated_at")

  updatedByAdmin AdminUser? @relation(fields: [updatedByAdminId], references: [adminUserId], onDelete: SetNull)

  @@index([updatedByAdminId], map: "idx_system_settings_updated_by")
  @@map("system_settings")
}

// ---------------------------------------------------------------------------
// 관리자 로그인 시도 기록 (brute-force 방지 / 감사)
// ---------------------------------------------------------------------------

model AdminLoginAttempt {
  loginAttemptId Int      @id @default(autoincrement()) @map("login_attempt_id")
  email          String   @map("email") @db.VarChar(255)
  succeeded      Boolean  @map("succeeded")
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([email, createdAt], map: "idx_login_attempts_email_created")
  @@index([ipAddress, createdAt], map: "idx_login_attempts_ip_created")
  @@map("admin_login_attempts")
}
